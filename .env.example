# ─────────────────────────────────────────────────────────────────────────────
# .env.example — SmartStudy AI
#
# Copy this file to .env and fill in your actual values.
# The .env file is listed in .gitignore and must NEVER be committed to Git.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SmartStudy AI"
APP_VERSION="0.1.0"

# Set to True to enable SQL query logging and verbose output
DEBUG=False

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api

# Comma-separated list of frontend origins allowed to call the API.
# Local development default is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Local development: SQLite (no setup required)
DATABASE_URL=sqlite:///./smartstudy.db

# Production: replace with your IBM Cloudant or PostgreSQL connection string
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/smartstudy

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Obtain these from your IBM Cloud account:
#   https://cloud.ibm.com/apidocs/watsonx-ai
#
# WATSONX_API_KEY is your IBM Cloud API key — keep it secret.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Cloud Object Storage ──────────────────────────────────────────────────
# Obtain these from your IBM COS service credentials in IBM Cloud:
#   https://cloud.ibm.com/objectstorage
IBM_COS_API_KEY=
IBM_COS_INSTANCE_CRN=
IBM_COS_BUCKET=smartstudy-documents
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# When running the frontend without the Vite proxy (e.g. in production),
# set this to the full backend URL.
# VITE_API_BASE_URL=https://your-backend.us-south.codeengine.appdomain.cloud/api
